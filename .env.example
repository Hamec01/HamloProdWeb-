# HamloProd — example environment. Copy to `.env` (compose + local) / `.env.local`.
# NEVER commit real credentials. Everything except this file is gitignored.

# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted PostgreSQL — the data backend. SERVER-ONLY (no NEXT_PUBLIC_).
#
#  * docker-compose.yml reads POSTGRES_ADMIN_PASSWORD / MIGRATOR_* / APP_* / *_HOST_PORT.
#  * The container publishes ONLY to 127.0.0.1 — not reachable from the network.
#  * Persistent data is a required bind mount at
#      /home/deploy/app-data/hamloprod/pgdata   (create it before the first `up`).
#  * Vercel -> VPS connectivity (TLS proxy / tunnel + a dedicated public endpoint)
#    is a separate, later step.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_HOST_PORT=55434

# Bootstrap superuser — local socket use only. NEVER put this in DATABASE_URL / DIRECT_URL.
POSTGRES_ADMIN_PASSWORD=

# Migration role: owns the DB + public schema, runs Prisma migrations.
# LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE.
MIGRATOR_DB_USER=hamloprod_migrator
MIGRATOR_DB_PASSWORD=

# Runtime role: CONNECT + USAGE + DML only, cannot CREATE/ALTER/DROP.
# LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE.
APP_DB_USER=hamloprod_app
APP_DB_PASSWORD=

# Runtime pool — least-privilege app role. Used by src/lib/db/client.ts.
DATABASE_URL=postgresql://hamloprod_app:APP_DB_PASSWORD@127.0.0.1:55434/hamloprod?schema=public
# Migrations only (DDL). Never read by application code.
DIRECT_URL=postgresql://hamloprod_migrator:MIGRATOR_DB_PASSWORD@127.0.0.1:55434/hamloprod?schema=public
# Dev-only: `prisma migrate dev` shadow database (pre-created, owned by the migrator).
SHADOW_DATABASE_URL=postgresql://hamloprod_migrator:MIGRATOR_DB_PASSWORD@127.0.0.1:55434/hamloprod_shadow?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Admin authentication (own auth — M6.1). SERVER-ONLY.
# ─────────────────────────────────────────────────────────────────────────────
# HMAC key for hashing session tokens. Minimum 32 bytes of entropy.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional extra allowed Origins for mutation requests (comma-separated, no
# wildcard). Set the exact Vercel Preview URL here for M7.2b browser testing —
# scripts/storage-provision.mts also folds these into the bucket CORS rules.
# Never derived from the request Host header.
AUTH_EXTRA_ORIGINS=

# Bootstrap admin — used ONLY by `npx tsx scripts/create-admin.ts`, never committed.
# Prefer passing them inline for a single run rather than storing here. See docs/admin-auth.md.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Backends
# ─────────────────────────────────────────────────────────────────────────────
# Data backend. Target and default: "postgres".
DATA_BACKEND=postgres
# Object storage backend. Target and default: "contabo-s3". Empty ⇒ contabo-s3.
STORAGE_BACKEND=contabo-s3

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (Contabo, S3-compatible). SERVER-ONLY.
# Do NOT create NEXT_PUBLIC_ copies of the access key or secret key.
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=usc1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=hamloprod-public
S3_BUCKET_PRIVATE=hamloprod-private
# Leave empty to derive `${S3_ENDPOINT}/${S3_BUCKET_PUBLIC}` (path-style). Set it
# once the exact public/CDN base for the public bucket is confirmed in Contabo.
S3_PUBLIC_BASE_URL=
# Contabo requires path-style addressing. "true" | "false" (empty ⇒ true).
S3_FORCE_PATH_STYLE=true

