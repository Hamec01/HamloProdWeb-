# HamloProd — example environment. Copy to `.env.local` and fill real values.
# NEVER commit real credentials. `.env.local` and `.env*` (except this file) are gitignored.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (current runtime backend — unchanged, still the default)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by the verified payment webhook. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Object storage (Contabo, S3-compatible) — M7. Not active until STORAGE_BACKEND=contabo-s3.
# All values below are SERVER-ONLY. Do NOT create NEXT_PUBLIC_ copies of the
# access key or secret key — they must never reach the client bundle.
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=usc1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=hamloprod-public
S3_BUCKET_PRIVATE=hamloprod-private
# Public base URL for building object URLs. Leave empty to derive it as
# `${S3_ENDPOINT}/${S3_BUCKET_PUBLIC}` (path-style). Set it once the exact
# public/CDN base for the public bucket is confirmed in the Contabo panel.
S3_PUBLIC_BASE_URL=
# Contabo requires path-style addressing. "true" | "false" (empty ⇒ true).
S3_FORCE_PATH_STYLE=true

# Active storage backend: "supabase" (default) | "contabo-s3".
# Keep "supabase" until buckets, CORS, presign and finalize are verified (M7.2).
STORAGE_BACKEND=supabase

# ─────────────────────────────────────────────────────────────────────────────
# Data backend (PostgreSQL migration — later phase). "supabase" (default) | "postgres".
# ─────────────────────────────────────────────────────────────────────────────
DATA_BACKEND=supabase

# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted PostgreSQL — M1. SERVER-ONLY (no NEXT_PUBLIC_).
#
#  * docker-compose.yml reads POSTGRES_* / APP_DB_* / *_HOST_PORT below.
#  * The container publishes only to 127.0.0.1 — it is not reachable from the
#    network. Vercel connectivity is a separate, later step.
# ─────────────────────────────────────────────────────────────────────────────

# --- container bootstrap (docker compose) ---
POSTGRES_HOST_PORT=55434
POSTGRES_DB=hamloprod
# Schema-owner / migration role.
POSTGRES_USER=hamloprod_migrator
POSTGRES_PASSWORD=
# Least-privilege runtime role (DML only, created by prisma/docker/initdb).
APP_DB_USER=hamloprod_app
APP_DB_PASSWORD=
# Optional: store data under the host app-data convention instead of a named volume.
# HAMLOPROD_PGDATA=/home/deploy/app-data/hamloprod/pgdata

# --- Prisma / application ---
# Runtime pool — least-privilege app role. Used by src/lib/db/client.ts.
DATABASE_URL=postgresql://hamloprod_app:APP_DB_PASSWORD@127.0.0.1:55434/hamloprod?schema=public
# Migrations only (DDL). Never read by application code.
DIRECT_URL=postgresql://hamloprod_migrator:POSTGRES_PASSWORD@127.0.0.1:55434/hamloprod?schema=public
