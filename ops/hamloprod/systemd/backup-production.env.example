# /etc/hamloprod/backup-production.env   (install as root:root, mode 0600)
# Consumed by hamloprod-backup@production.service. Contains NO secrets — only names and paths.

HP_ENV=production
HP_DB_CONTAINER=hamloprod-postgres
HP_DB_USER=postgres
HP_DB_NAME=hamloprod
HP_REPO_DIR=/home/deploy/projects/hamloprod-web
HP_BACKUP_ROOT=/home/deploy/backups/hamloprod
HP_MIRROR_ROOT=/mnt/250gb/hamloprod/backups
HP_BACKUP_SCRIPT=/home/deploy/projects/hamloprod-web/ops/hamloprod/backup-hamloprod.sh
HP_KEEP_DAILY=7
HP_KEEP_WEEKLY=4
HP_KEEP_MONTHLY=3
HP_KEEP_EVENT_DAYS=30
