// HamloProd — clean PostgreSQL foundation (migration phase M1.2 / M1.2a).
//
// Self-hosted target database. Legacy content is imported through reviewed,
// idempotence-guarded scripts; new code uses this schema only and must not read
// or write Supabase for entities already migrated.
//
// Roles:
//   DATABASE_URL       runtime, hamloprod_app (LOGIN NOSUPERUSER NOCREATEDB
//                      NOCREATEROLE; CONNECT + USAGE + DML only)
//   DIRECT_URL         migrations, hamloprod_migrator (owns DB + schema; still
//                      NOSUPERUSER NOCREATEDB NOCREATEROLE). Never used by the app.
//   SHADOW_DATABASE_URL dev-only: `prisma migrate dev` shadow DB (the migrator
//                      cannot CREATE DATABASE, so a dedicated one is pre-created).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  extensions        = [citext]
}

/// Every account has a role. A normal visitor is USER.
enum UserRole {
  ADMIN
  EDITOR
  ARTIST
  USER
}

/// One beat = one buyer. `sold`/`private` beats are hidden from the public catalogue.
enum BeatStatus {
  available
  reserved
  sold
  private
}

/// Allowed genres — mirrors BEAT_GENRES in src/lib/beats-taxonomy.ts.
enum BeatGenre {
  boombap
  rap
  trap
  drill
  another
}

enum ReleaseType {
  album
  ep
  mixtape
}

enum StorageVisibility {
  public
  private
}

/// Entity a pending upload will be attached to. Resolved by the service against `entityId`.
enum UploadEntityType {
  beat
  track
  artist
  post
}

/// upload-url -> PENDING; finalize (HeadObject ok) -> FINALIZED; bound to an
/// entity -> ATTACHED; scheduled for removal -> DELETING; TTL passed -> EXPIRED.
enum UploadIntentState {
  PENDING
  FINALIZED
  ATTACHED
  DELETING
  EXPIRED
}

/// Matches the storage layer's UploadKind strings (see src/lib/storage/keys.ts).
enum UploadKind {
  beatCover    @map("beat-cover")
  beatPreview  @map("beat-preview")
  beatMaster   @map("beat-master")
  beatArchive  @map("beat-archive")
  trackCover   @map("track-cover")
  trackAudio   @map("track-audio")
  artistAvatar @map("artist-avatar")
  postFile     @map("post-file")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored normalised (trimmed, lower-cased) by the app; `citext` makes the
  /// uniqueness constraint case-insensitive so the DB enforces it regardless.
  email           String    @unique @db.Citext
  /// Null for accounts that cannot password-log-in yet (OAuth / reset required).
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  role            UserRole  @default(USER)
  /// Set for ARTIST accounts — the artist profile they manage (FK added with the
  /// Artist model in a later phase).
  artistId        String?   @map("artist_id") @db.Uuid
  artist          Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  displayName     String?   @map("display_name")
  /// Last successful sign-in (own auth or, historically, Supabase). Informational.
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      Session[]
  uploadIntents UploadIntent[]
  orders        Order[]
  purchases     BeatPurchase[]
  reactions     BeatReaction[]
  comments      ContentComment[]
  ratings       ContentRating[]
  loyalty       LoyaltyPoint?

  @@index([artistId])
  @@map("users")
}

model Artist {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique
  artistName     String   @map("artist_name")
  trackTitle     String   @default("") @map("track_title")
  beatTitle      String   @default("") @map("beat_title")
  bio            String   @default("")
  photoKey       String?  @map("photo_key")
  coverPalette   String   @default("from-zinc-900 via-stone-900 to-black") @map("cover_palette")
  spotifyUrl     String   @default("") @map("spotify_url")
  appleMusicUrl  String   @default("") @map("apple_music_url")
  youtubeUrl     String   @default("") @map("youtube_url")
  vkUrl          String   @default("") @map("vk_url")
  telegramUrl    String   @default("") @map("telegram_url")
  yandexMusicUrl String   @default("") @map("yandex_music_url")
  tidalUrl       String   @default("") @map("tidal_url")
  soundcloudUrl  String   @default("") @map("soundcloud_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("artists")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Only the hash of the opaque session token is stored, never the token itself.
  tokenHash String    @unique @map("token_hash")
  /// Which surface issued this session: "admin" (/admin) or "public" (buyer).
  /// A token minted for one surface must never be accepted by the other.
  scope     String    @default("admin")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip        String?   @db.Inet
  userAgent String?   @map("user_agent")

  @@index([userId])
  @@index([expiresAt])
  @@index([scope, expiresAt])
  @@map("sessions")
}

model Beat {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String     @unique
  caseNumber           String     @unique @map("case_number")
  title                String
  status               BeatStatus @default(available)
  genre                BeatGenre  @default(boombap)
  substyle             String?
  mood                 String?
  bpm                  Int?
  description          String?
  durationSeconds      Int?       @map("duration_seconds")
  coverPalette         String     @default("from-stone-700 via-stone-900 to-zinc-950") @map("cover_palette")
  priceUsd             Int        @default(0) @map("price_usd")
  priceRub             Int        @default(0) @map("price_rub")
  featured             Boolean    @default(false)
  availableForDownload Boolean    @default(false) @map("available_for_download")

  /// Object-storage keys only — never a URL, and never a URL for a private file.
  /// Public keys resolve via the public base URL; private keys are only ever
  /// handed out as short-lived signed URLs.
  coverKey   String? @map("cover_key")
  previewKey String? @map("preview_key")
  masterKey  String? @map("master_key")
  archiveKey String? @map("archive_key")

  previewFileName  String? @map("preview_file_name")
  previewMimeType  String? @map("preview_mime_type")
  previewSizeBytes Int?    @map("preview_size_bytes")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders    Order[]
  contracts Contract[]
  purchases BeatPurchase[]
  reactions BeatReaction[]

  @@index([status])
  @@index([featured])
  @@map("beats")
}

model Release {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String      @unique
  artistName      String      @default("HaM") @map("artist_name")
  featArtistNames String      @default("") @map("feat_artist_names")
  releaseType     ReleaseType @map("release_type")
  coverPalette    String      @default("from-zinc-900 via-stone-900 to-black") @map("cover_palette")
  coverKey        String?     @map("cover_key")
  description     String      @default("")
  spotifyUrl      String      @default("") @map("spotify_url")
  appleMusicUrl   String      @default("") @map("apple_music_url")
  youtubeUrl      String      @default("") @map("youtube_url")
  releaseDate     DateTime    @map("release_date") @db.Date
  published       Boolean     @default(true)
  featured        Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tracks Track[]

  @@index([releaseType, published, createdAt])
  @@map("releases")
}

model Track {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  slug          String   @unique
  artistName    String   @map("artist_name")
  coverPalette  String   @default("from-zinc-900 via-stone-900 to-black") @map("cover_palette")
  coverKey      String?  @map("cover_key")
  audioKey      String?  @map("audio_key")
  spotifyUrl    String   @default("") @map("spotify_url")
  appleMusicUrl String   @default("") @map("apple_music_url")
  youtubeUrl    String   @default("") @map("youtube_url")
  releaseDate   DateTime @map("release_date") @db.Date
  releaseId     String?  @map("release_id") @db.Uuid
  release       Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  trackNumber   Int?     @map("track_number")
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([releaseId, trackNumber])
  @@map("tracks")
}

model Post {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  slug         String   @unique
  excerpt      String
  content      String
  category     String   @default("news")
  section      String   @default("general")
  coverPalette String   @default("from-amber-900 via-stone-900 to-black") @map("cover_palette")
  ctaLabel     String?  @map("cta_label")
  ctaUrl       String?  @map("cta_url")
  published    Boolean  @default(true)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([section, published, createdAt])
  @@map("posts")
}

model SiteSetting {
  key                String   @id
  title              String
  subtitle           String
  archiveHeadline    String   @map("archive_headline")
  archiveDescription String   @map("archive_description")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

/// Login rate-limiting. One row per HMAC(normalised email + IP). No email or IP
/// is stored in the clear. Old rows are swept opportunistically (no cron in M6.1).
model AuthThrottle {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  keyHash         String    @unique @map("key_hash")
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([blockedUntil])
  @@map("auth_throttle")
}

/// A server-authorised, single-use direct upload.
///
///   upload-url  -> create PENDING (expectedSize + contentType known)
///   finalize    -> only an existing PENDING intent; after HeadObject, write
///                  actualSize + finalizedAt and move to FINALIZED
///   attach      -> bind to its entity, write attachedAt, move to ATTACHED
///
model UploadIntent {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String            @map("owner_id") @db.Uuid
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entityType   UploadEntityType  @map("entity_type")
  entityId     String            @map("entity_id") @db.Uuid
  kind         UploadKind
  visibility   StorageVisibility
  /// The generated object key. Globally unique across both buckets.
  key          String            @unique
  contentType  String            @map("content_type")
  /// Size declared at upload-url time. Required.
  expectedSize BigInt            @map("expected_size")
  /// Real size from HeadObject at finalize time. Null until FINALIZED.
  actualSize   BigInt?           @map("actual_size")
  state        UploadIntentState @default(PENDING)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  finalizedAt  DateTime?         @map("finalized_at") @db.Timestamptz(6)
  attachedAt   DateTime?         @map("attached_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, expiresAt])
  @@index([ownerId])
  @@map("upload_intents")
}

/// Beat rights purchase order. Text status/currency/etc. mirror the legacy
/// Supabase table (CHECK constraints, not Prisma enums, keep it faithful).
model Order {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beatId               String    @map("beat_id") @db.Uuid
  beat                 Beat      @relation(fields: [beatId], references: [id], onDelete: Restrict)
  buyerUserId          String?   @map("buyer_user_id") @db.Uuid
  buyerUser            User?     @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerEmail           String    @map("buyer_email")
  buyerName            String?   @map("buyer_name")
  buyerCountry         String?   @map("buyer_country")
  buyerCity            String?   @map("buyer_city")
  buyerPhone           String?   @map("buyer_phone")
  buyerFullName        String?   @map("buyer_full_name")
  buyerStageName       String?   @map("buyer_stage_name")
  /// USD historically; `basePrice`/`finalPrice` are the market-currency amounts.
  basePriceUsd         Int       @map("base_price_usd")
  finalPriceUsd        Int       @map("final_price_usd")
  basePrice            Int       @default(0) @map("base_price")
  finalPrice           Int       @default(0) @map("final_price")
  discountPercent      Int       @default(0) @map("discount_percent")
  currency             String    @default("USD")
  market               String    @default("global")
  provider             String    @default("paypal")
  paymentProvider      String?   @map("payment_provider")
  status               String    @default("draft")
  licenseType          String    @default("basic") @map("license_type")
  contractLanguage     String    @default("ru") @map("contract_language")
  rightsFormStatus     String    @default("not_started") @map("rights_form_status")
  contractTemplateType String?   @map("contract_template_type")
  /// Object-storage key of the generated rights PDF (private bucket). Never a URL.
  contractPdfKey       String?   @map("contract_pdf_key")
  paymentExternalId    String?   @map("payment_external_id")
  paymentUrl           String?   @map("payment_url")
  downloadToken        String?   @unique @map("download_token")
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract Contract?

  @@index([beatId])
  @@index([buyerUserId])
  @@index([status, createdAt])
  @@index([paymentExternalId])
  @@map("orders")
}

/// One contract per order — the HTML snapshot shown at checkout and the optional
/// generated PDF key.
model Contract {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beatId       String   @map("beat_id") @db.Uuid
  beat         Beat     @relation(fields: [beatId], references: [id], onDelete: Restrict)
  buyerEmail   String   @map("buyer_email")
  htmlSnapshot String   @map("html_snapshot")
  /// Private object-storage key of the rendered PDF. Never a URL.
  pdfKey       String?  @map("pdf_key")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([beatId])
  @@index([buyerEmail])
  @@map("contracts")
}

/// Loyalty-point purchase ledger row (one per checkout of a free/paid beat).
model BeatPurchase {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beatId          String   @map("beat_id") @db.Uuid
  beat            Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  beatTitle       String   @map("beat_title")
  userId          String   @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail       String   @map("user_email")
  basePriceUsd    Int      @map("base_price_usd")
  discountPercent Int      @map("discount_percent")
  finalPriceUsd   Int      @map("final_price_usd")
  pointsEarned    Int      @default(1) @map("points_earned")
  orderId         String?  @map("order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("beat_purchases")
}

/// One like/dislike per (beat, user).
model BeatReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beatId    String   @map("beat_id") @db.Uuid
  beat      Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String   @map("user_email")
  reaction  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([beatId, userId])
  @@index([beatId])
  @@map("beat_reactions")
}

/// Public comment on a beat or track (polymorphic `contentId`, no FK).
model ContentComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String   @map("content_type")
  contentId   String   @map("content_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail   String   @map("user_email")
  comment     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contentType, contentId, createdAt])
  @@index([userId])
  @@map("content_comments")
}

/// One 1–5 star rating per (contentType, contentId, user).
model ContentRating {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType String   @map("content_type")
  contentId   String   @map("content_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail   String   @map("user_email")
  rating      Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([contentType, contentId, userId])
  @@index([contentType, contentId])
  @@map("content_ratings")
}

/// Running loyalty-point balance, one row per user.
model LoyaltyPoint {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String   @map("user_email")
  points    Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_loyalty_points")
}

/// Free MP3 download audit rows (buyer-facing beat/track downloads).
model BeatDownloadLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beatId     String   @map("beat_id") @db.Uuid
  beatTitle  String   @map("beat_title")
  fileFormat String   @default("mp3") @map("file_format")
  userId     String   @map("user_id") @db.Uuid
  userEmail  String   @map("user_email")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("beat_downloads")
}

model TrackDownloadLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  trackTitle String   @map("track_title")
  userId     String   @map("user_id") @db.Uuid
  userEmail  String   @map("user_email")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("track_downloads")
}
